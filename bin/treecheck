#!/bin/bash

# NVMe integrity checker - creates/verifies SHA-256 sidecar files
set -euo pipefail

VERSION="1.3.0"

# Config
HASH_EXT=".sha256"
VERBOSE=0
FORCE=0
NO_VERIFY=0
STRICT=0
EXCLUDE_DIRS=()
JOBS=0   # 0 = auto: one worker per CPU

# Escape byte standing in for a newline inside a one-line worker record.
# It has to reach the workers through the environment rather than being
# written as $'\001' at the point of use; see the note in hash_worker.
ESC_NL=$'\001'

# Set once the walk can be ordered; see the probe next to the worker-count
# resolution. Zero means this sort cannot read NUL-separated input and the
# walk is left in whatever order the filesystem returned.
SORT_NUL=0

# Wall-clock start, stamped before the walk so the summary can report it.
RUN_START=0

# Byte weights for the live progress display, filled by collect_sizes. Zero
# means the display counts files instead, which is always a valid fallback.
BYTES_OK=0
TOTAL_KB=0
SIZE_KB=()

# Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

usage() {
    cat << 'EOF'
Usage: treecheck [OPTIONS] <directory>

Walks <directory> and checks every file against its .sha256 sidecar,
reporting anything whose contents no longer match. Recursive by default.
Never modifies, moves or deletes your data.

OPTIONS:
  -c              Create missing sidecars, and verify the ones that exist
  -f              Overwrite existing sidecars (use with -c)
  -n              Skip verification (create only; requires -c)
  -e DIRS         Exclude directories, comma-separated
  -j N, --jobs N  Hash across N parallel workers (default: one per CPU)
  -v              Verbose (report skipped files)
  --no-recurse    Only the named directory (same as --max-depth 1)
  --max-depth N   Descend at most N levels
  --strict        Treat missing sidecars as a failure too
  -V, --version   Print version and exit
  -h              Show this help

EXIT STATUS:
  0   clean
  1   verification failed: a mismatch, an I/O error, or a failed walk
  2   nothing corrupt, but some files have no usable sidecar yet

EXAMPLES:
  treecheck /Volumes/Media                   Verify the whole tree
  treecheck -c /Volumes/Media                Create missing sidecars, verify rest
  treecheck -cn /Volumes/Media               Create only, skip verification
  treecheck --no-recurse /Volumes/Media      Top level only
  treecheck -e "temp,cache" /Volumes/Media   Skip those directories
  treecheck --strict /Volumes/Media          Missing sidecars are failures too
EOF
    exit "${1:-1}"
}

error() { echo -e "${RED}ERROR: $*${NC}" >&2; }

# Shared by the standalone and bundled -j forms; reports whichever spelling
# the caller used.
validate_jobs() {
    local opt="$1" val="$2"
    # All-zero strings like 00 parse as zero and would silently re-enter
    # automatic selection, so a positive integer must hold a nonzero digit.
    case "$val" in
        ''|*[!0-9]*) error "$opt needs a positive integer, got: ${val:-<missing>}"; return 1 ;;
        *[1-9]*) : ;;
        *) error "$opt needs a positive integer, got: $val"; return 1 ;;
    esac
}

FILE_LIST="" FIND_ERR="" RESULTS_DIR="" WORK_INPUT="" STREAMED=0
cleanup_tmp() {
    [ -n "$FILE_LIST" ] && rm -f "$FILE_LIST" "$FILE_LIST.sorted"
    [ -n "$FIND_ERR" ] && rm -f "$FIND_ERR" "$FIND_ERR.all"
    [ -n "${ORDERED_PATHS:-}" ] && rm -f "$ORDERED_PATHS"
    [ -n "$RESULTS_DIR" ] && rm -rf "$RESULTS_DIR"
    [ -n "$WORK_INPUT" ] && rm -f "$WORK_INPUT"
    [ -n "${CREATED_LOG:-}" ] && rm -f "$CREATED_LOG"
    [ -n "${INFLIGHT:-}" ] && rm -f "$INFLIGHT"
    [ -n "${DONE_LOG:-}" ] && rm -f "$DONE_LOG"
    [ -n "${MONBUF:-}" ] && rm -f "$MONBUF"
    [ -n "${ACTIVE:-}" ] && rm -f "$ACTIVE" "$ACTIVE.new"
    [ -n "${STREAMED_LOG:-}" ] && rm -f "$STREAMED_LOG"
    [ -n "${NEEDS_PRINT:-}" ] && rm -f "$NEEDS_PRINT"
    [ -n "${ALL_IDX:-}" ] && rm -f "$ALL_IDX"
    return 0
}
trap cleanup_tmp EXIT
success() { echo -e "${GREEN}✓ $*${NC}"; }

# Sizes travel as kibibytes because that is what du reports, and the whole
# progress display is integer arithmetic: bash has no floats, so the one
# fractional digit is produced by scaling the remainder before dividing.
human_kb() {
    local kb="$1"
    if [ "$kb" -lt 1024 ]; then
        printf '%dK' "$kb"
    elif [ "$kb" -lt 1048576 ]; then
        printf '%d.%dM' $((kb/1024)) $((kb%1024*10/1024))
    elif [ "$kb" -lt 1073741824 ]; then
        printf '%d.%dG' $((kb/1048576)) $((kb%1048576*10/1048576))
    else
        printf '%d.%dT' $((kb/1073741824)) $((kb%1073741824*10/1073741824))
    fi
}

# Durations read as a duration rather than a raw second count, which stops
# being legible somewhere around the four-digit mark on a large volume.
fmt_dur() {
    local s="$1"
    if [ "$s" -lt 60 ]; then
        printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then
        printf '%dm%02ds' $((s/60)) $((s%60))
    else
        printf '%dh%02dm' $((s/3600)) $((s%3600/60))
    fi
}

# Name the files behind a nonzero counter. Both engines collect these in
# memory rather than in a scratch file: the recap is a convenience, and it
# should not be the thing that needs a writable filesystem to work. Only the
# first FAILPATH_CAP paths are kept, so a wholly failed volume cannot bury
# the summary it belongs to, and the count is bounded no matter how bad the
# run gets. The totals come from the counters, which are exact regardless.
FAILPATH_CAP=20
MISMATCH_PATHS=()
IOERR_PATHS=()

record_mismatch() {
    [ ${#MISMATCH_PATHS[@]} -lt $FAILPATH_CAP ] && MISMATCH_PATHS+=("$1")
    return 0
}

record_ioerr() {
    [ ${#IOERR_PATHS[@]} -lt $FAILPATH_CAP ] && IOERR_PATHS+=("$1")
    return 0
}

# Called as: print_failure_paths <total> <path>...
# The empty case has to be spelled ${arr[@]+"${arr[@]}"} at the call site;
# a bare "${arr[@]}" on an empty array is an unbound variable under set -u
# in bash 3.2, which is the shell this runs under on macOS.
print_failure_paths() {
    local total="$1" p
    shift
    [ "$#" -gt 0 ] || return 0
    for p in "$@"; do
        echo "  $p"
    done
    [ "$total" -gt "$#" ] && echo "  ... and $((total-$#)) more"
    return 0
}

# Prints the hash on success. Returns non-zero if the file could not be read,
# which a pipeline into awk would otherwise hide.
compute_hash() {
    local file="$1" out
    out=$(shasum -a 256 "$file" 2>/dev/null) || return 1
    printf '%s' "${out%% *}"
}

# Status: 0 verified, 1 mismatch, 2 no usable sidecar, 3 I/O error
verify_file_hash() {
    # hash_file must be its own statement: in one combined "local", ${file}
    # still holds the CALLER'S value, so the sidecar path silently resolved
    # through whatever global "file" happened to be lying around.
    local file="$1"
    local hash_file="${file}${HASH_EXT}"
    local stored_hash current_hash

    if [ ! -f "$hash_file" ]; then
        echo "no sidecar!"
        return 2
    fi

    if ! stored_hash=$(tr -d '[:space:]' < "$hash_file" 2>/dev/null); then
        echo "sidecar unreadable!"
        return 3
    fi
    [ -z "$stored_hash" ] && {
        echo "empty sidecar!"
        return 2
    }

    echo -n "sidecar found, computing hash... "
    current_hash=$(compute_hash "$file")
    if [ -z "$current_hash" ]; then
        echo "unreadable!"
        return 3
    fi

    if [ "$stored_hash" = "$current_hash" ]; then
        echo "✓"
        return 0
    else
        echo "hash mismatch! (sidecar: $stored_hash, computed: $current_hash)"
        return 1
    fi
}

# Returns status code and message
create_file_hash() {
    # hash_file must be its own statement: in one combined "local", ${file}
    # still holds the CALLER'S value, so the sidecar path silently resolved
    # through whatever global "file" happened to be lying around.
    local file="$1"
    local hash_file="${file}${HASH_EXT}"
    local current_hash

    # If hash exists and not forced, only verify if not empty
    if [ -f "$hash_file" ] && [ $FORCE -eq 0 ]; then
        local stored_hash
        if ! stored_hash=$(tr -d '[:space:]' < "$hash_file" 2>/dev/null); then
            echo "sidecar unreadable!"
            return 3
        fi
        if [ -n "$stored_hash" ]; then
            # Verify existing hash unless NO_VERIFY is set
            if [ $NO_VERIFY -eq 0 ]; then
                echo -n "sidecar found, computing hash... "
                current_hash=$(compute_hash "$file")
                if [ -z "$current_hash" ]; then
                    echo "unreadable!"
                    return 3
                fi
                if [ "$stored_hash" = "$current_hash" ]; then
                    echo "✓"
                    return 0
                else
                    echo "hash mismatch! (sidecar: $stored_hash, computed: $current_hash)"
                    return 1
                fi
            else
                echo "sidecar found, skipping verification"
                return 4
            fi
        fi
    fi

    # Create new hash. A file that cannot be read must not get a sidecar,
    # otherwise an empty hash would be recorded as though it were the truth.
    #
    # Everything below completes the single line this function was called on.
    # Reporting the creation and the read-back on separate lines made create
    # mode the only path emitting more than one line per file, which the
    # parallel engine then had to escape and rebuild, and rebuilt wrongly.
    echo -n "no sidecar, creating... "
    current_hash=$(compute_hash "$file")
    if [ -z "$current_hash" ]; then
        echo "unreadable!"
        return 3
    fi
    # The write's stderr stays silent: bash would otherwise interleave its own
    # "Permission denied" diagnostic with a shell-specific prefix (the two
    # engines run under different parents), and the message below already says
    # what happened in this tool's words. Redirecting stderr BEFORE the target
    # matters: once the failing redirect is reached, stderr must already be
    # somewhere harmless or the diagnostic escapes anyway.
    if ! echo "$current_hash" 2>/dev/null > "$hash_file"; then
        echo "cannot write sidecar!"
        # Distinct from the read-failure status on purpose: parallel workers
        # need to know the write itself failed, so creation is not counted
        # for a sidecar that never landed. Both engines map it to I/O errors.
        return 5
    fi
    CNT_CREATED=$((CNT_CREATED+1))
    # A parallel worker runs this in a subshell and cannot mutate the
    # parent's counters, so when a creation log is wired up the event
    # travels there instead. The sequential engine never sets the
    # variable and keeps this counter as its source of truth.
    if [ -n "${CREATED_LOG:-}" ]; then
        # The sidecar exists whether or not its event lands, so this failure
        # must not hide the creation. Status 6 tells the replay to count it
        # as both created and unverified and to warn loudly afterwards,
        # which keeps the engines agreeing on Created without ever printing
        # a read-back verdict that never happened.
        # stderr redirected before the target so a failed redirect cannot
        # leak the shell's own diagnostic past the suppression.
        if ! printf '%s\n' "$file" 2>/dev/null >> "$CREATED_LOG"; then
            echo "created, but cannot record creation event!"
            return 6
        fi
    fi

    # Read the sidecar back and compare it against the digest still in hand.
    #
    # The digest is NOT recomputed from the source here. Doing that read every
    # file a second time, doubling the I/O of every create run, and the only
    # thing the second read can catch beyond this comparison is media that
    # returns different bytes on consecutive reads. What the read-back is for
    # is proving the sidecar landed intact, and comparing its contents against
    # the hash just written proves exactly that.
    if [ $NO_VERIFY -eq 0 ]; then
        local stored_hash
        if ! stored_hash=$(tr -d '[:space:]' < "$hash_file" 2>/dev/null); then
            echo "created, but sidecar unreadable!"
            return 3
        fi
        if [ "$stored_hash" = "$current_hash" ]; then
            echo "created and verified ✓"
            return 0
        else
            echo "created, but read-back mismatch! (sidecar: $stored_hash, computed: $current_hash)"
            return 1
        fi
    fi

    # Sidecar was written but deliberately not read back, so it has not been
    # verified and must not be counted as though it had been.
    echo "created (not read back)"
    return 4
}

# One unit of parallel work. Emits a single tab-separated record:
#   written to RESULTS_DIR/<index>; one file per record, no shared appends
# The status codes are data here, not exit codes: the worker always exits 0
# so that xargs does not mistake an ordinary corrupt file for a broken run.
# Creation events travel out of band: create_file_hash appends them to
# $CREATED_LOG when the parallel engine wires one up, because a subshell
# cannot mutate the parent's counters and inferring the event from pre-call
# state or final status gets both the unreadable-source case and the
# empty-sidecar rewrite wrong.
hash_worker() {
    local i="$1" f="$2" out rc
    # Progress events travel only when an interactive display is wired up.
    # Both writes are a handful of bytes, small enough that concurrent
    # appends cannot interleave.
    if [ -n "${INFLIGHT:-}" ]; then
        # Display-only bookkeeping: losing an entry makes the status line
        # less informative, never the verification less correct.
        if ! printf '%s\t%s\n' "$i" "$f" 2>/dev/null >> "$INFLIGHT"; then
            echo "treecheck: progress tracking is degraded for this file" >&2
        fi
    fi
    if [ "$WORKER_MODE" = "create" ]; then
        out=$(create_file_hash "$f" 2>&1); rc=$?
    else
        out=$(verify_file_hash "$f" 2>&1); rc=$?
    fi
    # One record must be one physical line, so any newline travels escaped
    # and is restored just before display. Every verdict is single-line now,
    # which leaves this as a backstop against anything unexpected reaching
    # the merged stderr rather than a path the normal run takes.
    #
    # The replacement MUST come from the environment. Written literally as
    # $'\001' it does not survive the trip: export -f re-serializes the body
    # through bash's own pretty-printer, which renders the ANSI-C escape as a
    # quoted control character, and the child re-parses that into TWO
    # replacements per match. That is what turned create mode's second line
    # into a blank line followed by the verdict, under -j > 1 only. The
    # pattern side round-trips correctly and is left as it was.
    out=${out//$'\n'/"$ESC_NL"}
    # Each result lands in its own index-named file. Appending to one shared
    # file is only collision-free while every write stays under the stdio
    # buffer size, and a deep path plus a mismatch diagnostic can exceed
    # that; interleaved halves would corrupt the stream.
    printf '%s\t%s\tVerifying %s ... %s\n' "$i" "$rc" "$f" "$out" \
        > "$RESULTS_DIR/$i"
    if [ -n "${DONE_LOG:-}" ]; then
        # A lost event means the live view skips this verdict; the ordered
        # replay detects that and prints it at the end, so the failure must
        # be visible but must not discard the result itself.
        if ! printf '%s\n' "$i" 2>/dev/null >> "$DONE_LOG"; then
            echo "treecheck: could not record the completion event; this verdict will appear in walk order instead of live" >&2
        fi
    fi
    return 0
}

# Live display for an interactive terminal: completed verdicts scroll above
# a continuously redrawn status line carrying a spinner, the done count out
# of the total, elapsed time, and what is currently being hashed. Completions
# arrive in whatever order the workers finish; strict walk order is a
# property of the piped output, not of a live view.
# Emit what arrived in $1 since byte $2 and set CONSUMED to those bytes.
# Every event is a single write of a handful of bytes - well under any
# buffering boundary - so a chunk can only ever end on a line boundary;
# there is no partial-line case to defend against.
consume_new() {
    local size
    if ! size=$(wc -c < "$1"); then
        echo "treecheck: could not size a progress log" >&2
        CONSUMED=0
        return 1
    fi
    if [ "$size" -le "$2" ]; then CONSUMED=0; return 0; fi
    if ! tail -c +"$(($2+1))" "$1" > "$MONBUF" 2>/dev/null; then
        echo "treecheck: could not read new progress events" >&2
        CONSUMED=0
        return 1
    fi
    if ! CONSUMED=$(wc -c < "$MONBUF"); then
        echo "treecheck: could not size new progress events" >&2
        CONSUMED=0
        return 1
    fi
}

# Weigh every dispatched file so the progress display can talk about bytes
# instead of file counts. Sets BYTES_OK=1 and fills TOTAL_KB and SIZE_KB[] on
# success; on any failure it leaves BYTES_OK=0 and the display falls back to
# counting files, which is what it did before. This is a display aid, so
# nothing in here may fail the run.
#
# Sizes come from du rather than stat because du -k spells the same thing the
# same way on BSD and GNU, where stat needs -f%z on one and -c%s on the other.
# What du reports is allocated blocks rather than apparent size, which is if
# anything the better weight here: allocated blocks are what actually gets
# read off the disk.
collect_sizes() {
    local usable="$1" total="$2" kb i=0
    BYTES_OK=0
    TOTAL_KB=0
    SIZE_KB=()
    [ "$usable" -eq 1 ] || return 0
    [ "$total" -gt 0 ] || return 0
    command -v du >/dev/null 2>&1 || return 0
    command -v awk >/dev/null 2>&1 || return 0
    command -v tr >/dev/null 2>&1 || return 0

    # Read through a process substitution rather than a scratch file, and
    # rather than a pipe: `cmd | while read` puts the loop in a subshell, so
    # the array it fills would not survive back to the caller.
    #
    # du exits nonzero if any single argument could not be stat'd, and xargs
    # turns that into 123, so neither status can gate this. The join below
    # tolerates missing entries, which is the same thing measured properly.
    #
    # Positional matching would be wrong: du drops arguments it cannot stat
    # and reports a hardlinked inode once per invocation, so its output is
    # not one line per input. Join on the path instead, and split on the
    # FIRST tab only, since a path may legitimately contain one. awk reads
    # du's output from stdin ("-") and then the ordered list, so the second
    # pass emits exactly one weight per dispatched file, in dispatch order.
    while IFS= read -r kb; do
        case "$kb" in
            ''|*[!0-9]*) kb=0 ;;
        esac
        SIZE_KB[$i]=$kb
        TOTAL_KB=$((TOTAL_KB+kb))
        i=$((i+1))
    done < <(tr '\n' '\0' < "$ORDERED_PATHS" 2>/dev/null \
             | xargs -0 du -k 2>/dev/null \
             | awk '
                 NR==FNR {
                     t = index($0, "\t")
                     if (t > 0) size[substr($0, t+1)] = substr($0, 1, t-1)
                     next
                 }
                 { k = size[$0]; print (k == "" ? "0" : k) }
               ' - "$ORDERED_PATHS" 2>/dev/null)

    # One weight per dispatched file or none at all: a short list would put
    # every index past the gap against the wrong size.
    if [ "$i" -eq "$total" ] && [ "$TOTAL_KB" -gt 0 ]; then
        BYTES_OK=1
    else
        TOTAL_KB=0
        SIZE_KB=()
    fi
    return 0
}

progress_monitor() {
    local total="$1" xpid="$2"
    # Both event logs are consumed through byte offsets, so each tick pays
    # only for events that arrived since the last one. The active set is
    # maintained incrementally for the same reason: started entries are
    # appended as they arrive, completed ones are filtered out, and its
    # size never exceeds the number of workers actually mid-file.
    local doff=0 ioff=0 done=0 spin=0 start=$SECONDS idx line frames='|/-\\|'
    local inflight rate_x10 pct a1 a2 a3 done_kb=0 elapsed rate_kb eta
    while kill -0 "$xpid" 2>/dev/null; do
        if ! consume_new "$INFLIGHT" "$ioff"; then
            printf '\r\033[Kprogress events unreadable; retrying\n'
            sleep 0.5
            continue
        fi
        if [ "$CONSUMED" -gt 0 ]; then
            ioff=$((ioff+CONSUMED))
            while IFS= read -r evline; do
                if ! printf '%s\n' "$evline" 2>/dev/null >> "$ACTIVE"; then
                    echo "treecheck: the live file list could not be updated" >&2
                fi
            done < "$MONBUF"
        fi
        if ! consume_new "$DONE_LOG" "$doff"; then
            printf '\r\033[Kprogress events unreadable; retrying\n'
            sleep 0.5
            continue
        fi
        if [ "$CONSUMED" -gt 0 ]; then
            doff=$((doff+CONSUMED))
            while IFS= read -r idx; do
                [ -n "$idx" ] || continue
                done=$((done+1))
                # Bytes, not files, drive the percentage. A media tree mixes
                # multi-gigabyte originals with kilobyte metadata sidecars,
                # so a file count says almost nothing about how much hashing
                # is left. An index with no recorded size contributes zero,
                # which loses a little accuracy and never stalls the display.
                done_kb=$((done_kb + ${SIZE_KB[$idx]:-0}))
                # The completed index leaves the active set; grep status 1
                # means nothing was left, which is fine. Anything else, or a
                # failed replacement, degrades the display and says so.
                local grc=0
                grep -v "^${idx}"$'\t' "$ACTIVE" \
                    > "$ACTIVE.new" 2>/dev/null || grc=$?
                if [ $grc -gt 1 ]; then
                    printf '\r\033[Kcould not update the live file list\n'
                fi
                if ! mv "$ACTIVE.new" "$ACTIVE"; then
                    printf '\r\033[Kcould not update the live file list\n'
                fi
                if ! printf '%s\n' "$idx" 2>/dev/null >> "$STREAMED_LOG"; then
                    printf '\r\033[Kcould not record a display ledger entry; that verdict will appear again in walk order\n'
                    continue
                fi
                if [ -s "$RESULTS_DIR/$idx" ]; then
                    IFS=$'\t' read -r _ _ line < "$RESULTS_DIR/$idx" || line=""
                    line=${line//"$ESC_NL"/$'\n'}
                    printf '\r\033[K%s\n' "$line"
                fi
            done < "$MONBUF"
        fi
        # Last three started-but-not-finished paths, oldest first.
        a1="" a2="" a3=""
        while IFS=$'\t' read -r _ apath; do
            a1=$a2; a2=$a3; a3=${apath##*/}
        done < "$ACTIVE"
        inflight=""
        [ -n "$a1" ] && inflight="$a1"
        [ -n "$a2" ] && inflight="${inflight:+$inflight, }$a2"
        [ -n "$a3" ] && inflight="${inflight:+$inflight, }$a3"
        elapsed=$((SECONDS-start))
        if [ "$BYTES_OK" -eq 1 ]; then
            # Throughput over the whole run so far, not an instantaneous
            # sample: a per-tick rate on a mix of huge and tiny files swings
            # hard enough to make the remaining estimate useless.
            rate_kb=0
            [ "$elapsed" -gt 0 ] && rate_kb=$((done_kb/elapsed))
            pct=$((done_kb*100/TOTAL_KB))
            if [ "$rate_kb" -gt 0 ]; then
                eta=$(fmt_dur $(((TOTAL_KB-done_kb)/rate_kb)))
            else
                eta="--"
            fi
            printf '\r\033[K %s %d/%d %d%% %s/%s %s %s/s eta %s hashing: %s' \
                "${frames:$((spin%4)):1}" "$done" "$total" "$pct" \
                "$(human_kb "$done_kb")" "$(human_kb "$TOTAL_KB")" \
                "$(fmt_dur "$elapsed")" "$(human_kb "$rate_kb")" "$eta" \
                "${inflight:-...}"
        else
            # No usable sizes, so the percentage falls back to the file count
            # and there is nothing honest to base an estimate on.
            # Tenths first: integer division would truncate 0.5 to 0.0.
            rate_x10=0
            [ "$elapsed" -gt 0 ] && rate_x10=$((done*10/elapsed))
            pct=0
            if [ "$total" -gt 0 ]; then pct=$((done*100/total)); fi
            printf '\r\033[K %s %d/%d %d%% %s %d.%d files/s hashing: %s' \
                "${frames:$((spin%4)):1}" "$done" "$total" "$pct" \
                "$(fmt_dur "$elapsed")" "$((rate_x10/10))" "$((rate_x10%10))" \
                "${inflight:-...}"
        fi
        spin=$((spin+1))
        sleep 0.5
    done
    # Final drain for events that landed between the last poll and exit.
    # On a failed read the ordered replay picks everything up anyway.
    if ! consume_new "$DONE_LOG" "$doff"; then
        printf '\r\033[Kprogress events unreadable\n'
    fi
    if [ "$CONSUMED" -gt 0 ]; then
        while IFS= read -r idx; do
            [ -n "$idx" ] || continue
            if ! printf '%s\n' "$idx" 2>/dev/null >> "$STREAMED_LOG"; then
                continue
            fi
            if [ -s "$RESULTS_DIR/$idx" ]; then
                IFS=$'\t' read -r _ _ line < "$RESULTS_DIR/$idx" || line=""
                line=${line//"$ESC_NL"/$'\n'}
                printf '\r\033[K%s\n' "$line"
            fi
        done < "$MONBUF"
    fi
    printf '\r\033[K'
}

# Hash FILE_LIST across $JOBS workers. Each result lands in its own
# index-named file under RESULTS_DIR; replay walks the indices in order, so
# the output is identical to what the sequential engine prints, whatever
# order the workers finish in.
parallel_process_files() {
    local mode="$1"
    RESULTS_DIR=$(mktemp -d "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary directory"; exit 1; }
    WORK_INPUT=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
    CREATED_LOG=""
    if [ "$mode" = "create" ]; then
        CREATED_LOG=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
    fi

    # The parallel engine needs xargs -P, which is common but not part of
    # POSIX xargs. Probe once up front instead of dying mid-walk.
    if ! printf 'ok\n' | xargs -P 1 -n1 true 2>/dev/null; then
        error "this xargs cannot run parallel workers (-P unsupported)"
        error "rerun with -j 1"
        exit 1
    fi

    WORKER_MODE="$mode"
    STREAMED=0
    INFLIGHT="" DONE_LOG="" MONBUF="" ACTIVE="" STREAMED_LOG="" NEEDS_PRINT="" ALL_IDX=""
    STREAMED_LOG=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
    if [ -t 1 ]; then
        INFLIGHT=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        DONE_LOG=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        MONBUF=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        ACTIVE=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        NEEDS_PRINT=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        ALL_IDX=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        ORDERED_PATHS=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
        STREAMED=1
    fi
    export WORKER_MODE HASH_EXT FORCE NO_VERIFY CREATED_LOG RESULTS_DIR INFLIGHT DONE_LOG ESC_NL
    export -f hash_worker verify_file_hash create_file_hash compute_hash

    echo "Hashing with $JOBS parallel workers..."

    # Index and path travel as two NUL-separated arguments per worker. The
    # enumeration runs against a file, not a pipeline: inside `while | xargs`
    # the loop is a subshell and its counter never comes back, which would
    # silently report zero dispatched files.
    local idx=0 sizes_ok=$STREAMED
    while IFS= read -r -d '' f; do
        f="$TARGET_DIR/${f#./}"
        case $f in
            # Newlines split the record stream and \x01 is the escape byte
            # for multi-line verdicts, so neither may travel inside a path.
            # Both are refused before any hashing starts; -j 1 handles them.
            *$'\n'*)
                error "cannot hash in parallel: path contains a newline: $f"
                error "rerun with -j 1"
                exit 1 ;;
            *$'\001'*)
                error "cannot hash in parallel: path contains a 0x01 byte: $f"
                error "rerun with -j 1"
                exit 1 ;;
        esac
        # A second, newline-separated copy of the same paths in the same
        # order, for the sizing pass below. Safe as newline-separated text
        # precisely because the guard above has already refused any path
        # that contains a newline.
        if [ "$sizes_ok" -eq 1 ]; then
            printf '%s\n' "$f" >> "$ORDERED_PATHS" || sizes_ok=0
        fi
        printf '%s\0%s\0' "$idx" "$f"
        idx=$((idx+1))
    done < "$FILE_LIST" > "$WORK_INPUT"
    TOTAL_FILES=$idx

    collect_sizes "$sizes_ok" "$TOTAL_FILES"

    # xargs is guarded against empty input because GNU and BSD disagree on
    # whether an empty list still runs the command once.
    if [ "$TOTAL_FILES" -gt 0 ]; then
        if [ "$STREAMED" -eq 1 ]; then
            xargs -0 -n2 -P "$JOBS" bash -c 'hash_worker "$@"' _ \
                < "$WORK_INPUT" >/dev/null &
            XPID=$!
            progress_monitor "$TOTAL_FILES" "$XPID"
            wait "$XPID" || { error "parallel hashing failed"; exit 1; }
        else
            xargs -0 -n2 -P "$JOBS" bash -c 'hash_worker "$@"' _ \
                < "$WORK_INPUT" >/dev/null || { error "parallel hashing failed"; exit 1; }
        fi
    fi

    # Replay walks the indices in order, so ordering needs no sort and a
    # missing or empty result is named precisely instead of shifting every
    # verdict after it. On an interactive terminal the monitor already
    # displayed its share; the indices it missed are printed here so every
    # verdict reaches the user exactly once.
    local i rc line event_failures=0 NP_NEXT="" idxgen=0
    if [ "$STREAMED" -eq 1 ]; then
        # The full index range is generated in a regular file by a loop whose
        # failure is checked: an empty range here would silently suppress
        # every fallback verdict.
        : > "$ALL_IDX" || { error "could not prepare the replay index"; exit 1; }
        while [ "$idxgen" -lt "$TOTAL_FILES" ]; do
            if ! printf '%s\n' "$idxgen" >> "$ALL_IDX"; then
                error "could not build the replay index"
                exit 1
            fi
            idxgen=$((idxgen+1))
        done
        if ! awk 'NR==FNR { s[$1]; next } !($1 in s) { print }' \
                "$STREAMED_LOG" "$ALL_IDX" > "$NEEDS_PRINT"; then
            error "could not determine which verdicts the live view missed"
            exit 1
        fi
        rm -f "$ALL_IDX"
        if [ -s "$NEEDS_PRINT" ]; then
            exec 3< "$NEEDS_PRINT"
            IFS= read -r -u 3 NP_NEXT || NP_NEXT=""
        fi
    fi
    # The failure recap needs the path, and the record cannot carry it as its
    # own field: a tab inside a path would shift the fields after it. The walk
    # list is already in dispatch order and record N is its Nth entry, so it
    # is read in lockstep here instead, which stays exact for any path bytes.
    local failpath=""
    exec 4< "$FILE_LIST"
    for (( expected=0; expected<TOTAL_FILES; expected++ )); do
        if IFS= read -r -d '' failpath <&4; then
            failpath="$TARGET_DIR/${failpath#./}"
        else
            failpath=""
        fi
        # A path containing a newline would split its record and shift every
        # index after it; a tab would shift one record's fields past
        # validation. Newline and escape-byte paths are refused before
        # dispatch, so this guard is the backstop that keeps a corrupted
        # stream from printing shifted or mislabeled verdicts: a report that
        # looks right but describes the wrong files is the one failure this
        # tool must never have. Sequential mode handles such trees correctly.
        RESULT_FILE="$RESULTS_DIR/$expected"
        if [ ! -s "$RESULT_FILE" ]; then
            error "internal: no result arrived for record $expected"
            error "rerun with -j 1 and report this output"
            exit 1
        fi
        IFS=$'\t' read -r i rc line < "$RESULT_FILE" || {
            error "internal: could not read result for record $expected"
            error "rerun with -j 1 and report this output"
            exit 1
        }
        # Backstop against a record whose index does not match its slot.
        if [ "$i" != "$expected" ]; then
            error "internal: record $expected carries index $i"
            error "rerun with -j 1 and report this output"
            exit 1
        fi
        case $rc in
            0|1|2|3|4|5|6) : ;;
            *) error "internal: record $i carries an unknown status"; error "rerun with -j 1 and report this output"; exit 1 ;;
        esac
        line=${line//"$ESC_NL"/$'\n'}
        # On an interactive terminal the monitor streamed most verdicts as
        # they completed; the ones whose progress event was lost appear here,
        # in walk order, exactly once each. A pipe gets every verdict.
        if [ "$STREAMED" -eq 0 ]; then
            echo "$line"
        elif [ -n "$NP_NEXT" ] && [ "$expected" = "$NP_NEXT" ]; then
            echo "$line"
            if IFS= read -r -u 3 NP_NEXT; then :; else NP_NEXT=""; fi
        fi
        case $rc in
            0) CNT_OK=$((CNT_OK+1)) ;;
            1) CNT_MISMATCH=$((CNT_MISMATCH+1))
               record_mismatch "$failpath" ;;
            2) CNT_MISSING=$((CNT_MISSING+1)) ;;
            3) CNT_IOERR=$((CNT_IOERR+1))
               record_ioerr "$failpath" ;;
            4) CNT_UNVERIFIED=$((CNT_UNVERIFIED+1)) ;;
            # A sidecar whose write failed is an I/O error like an unreadable
            # source; the distinct code exists only so creation is not counted.
            5) CNT_IOERR=$((CNT_IOERR+1))
               record_ioerr "$failpath" ;;
            # Written but its creation event could not be recorded: still a
            # creation, and no read-back happened, so it counts as neither
            # verified nor I/O-lost.
            6) CNT_CREATED=$((CNT_CREATED+1))
               CNT_UNVERIFIED=$((CNT_UNVERIFIED+1))
               event_failures=$((event_failures+1))
               CNT_UNVERIFIED_AFTER_EVENT_FAIL=$((CNT_UNVERIFIED_AFTER_EVENT_FAIL+1)) ;;
        esac
        CNT_SCANNED=$((CNT_SCANNED+1))
    done
    # No "2>/dev/null" on these. A bare exec carrying a redirection applies
    # it to the SHELL, permanently: the suppression silenced every diagnostic
    # for the rest of the run, so a parallel run that failed printed its
    # summary and then exited 1 with no "Completed with errors" at all, and
    # every error() below this point went nowhere. Closing a descriptor that
    # was never opened succeeds anyway, so nothing needed suppressing.
    exec 3<&-
    exec 4<&-

    # Creation events arrived through the log, not through records. Status-6
    # creations never made it into the log, so their count is added back.
    if [ "$mode" = "create" ]; then
        # Checked alone rather than in a pipeline: the status of this read
        # must not depend on shell options surviving around it.
        if ! CREATED_COUNT=$(wc -l < "$CREATED_LOG"); then
            error "could not read the creation log"
            exit 1
        fi
        CNT_CREATED=${CREATED_COUNT//[[:space:]]/}
        CNT_CREATED=$((CNT_CREATED+event_failures))
    fi
    if [ $event_failures -gt 0 ]; then
        error "$event_failures sidecar(s) were created but their creation event could not be recorded; the Created count in the summary below still includes them"
    fi

    if [ "$CNT_SCANNED" -ne "$TOTAL_FILES" ]; then
        error "internal: $TOTAL_FILES files were dispatched but $CNT_SCANNED results came back"
        error "rerun with -j 1 and report this output"
        exit 1
    fi
}

process_files() {
    local mode="$1" skipped=0
    local find_expr=()
    CNT_SCANNED=0 CNT_OK=0 CNT_MISMATCH=0 CNT_MISSING=0 CNT_IOERR=0 CNT_CREATED=0 CNT_UNVERIFIED=0
    CNT_UNVERIFIED_AFTER_EVENT_FAIL=0

    # Build find expression.
    #
    # Hidden entries are PRUNED, not merely filtered out of the results. The
    # previous "! -path */.*" only discarded matches after the fact, so find
    # still descended into .Trashes, .DocumentRevisions-V100, .TemporaryItems
    # and friends. On a real volume those are unreadable, which made find exit
    # non-zero and turned an ordinary scan into a reported walk failure.
    #
    # The pattern is ".?*" rather than ".*" because find's starting point is
    # "." itself: ".*" matches it, prunes the entire tree and finds nothing.
    find_expr=(
      -name '.?*' -prune
      -o
      -type f
      ! -name "*$HASH_EXT"
  )

  # Exclude user-specified directories
  if [ ${#EXCLUDE_DIRS[@]:-} -gt 0 ]; then
      for exclude_dir in "${EXCLUDE_DIRS[@]}"; do
        find_expr+=( ! -path "*/$exclude_dir/*" )
    done
fi

find_expr+=(-print0)

# If recursive is disabled, add maxdepth
[ -n "$MAXDEPTH" ] && find_expr=(-maxdepth "$MAXDEPTH" "${find_expr[@]}")

# Count every file the walk could have reached, so that subtracting the
# number actually checked reports what was passed over and why.
#
# This deliberately does NOT reuse find_expr. Sharing it would make the two
# counts identical and the difference permanently zero. The one thing both
# must agree on is pruning hidden entries, since descending into them is what
# breaks on a real volume; sidecars and --exclude paths are exactly the
# categories this difference is meant to surface.
if [ $VERBOSE -eq 1 ]; then
    local all_files=0
    # Same cd-then-"find ." form as the real walk: with an absolute path the
    # starting point itself would match ".?*" whenever the target is hidden
    # (treecheck ~/.config), pruning the entire tree and counting nothing.
    ( cd "$TARGET_DIR" && find . ${MAXDEPTH:+-maxdepth "$MAXDEPTH"} -name '.?*' -prune -o -type f -print0 ) > "$FIND_ERR.all" 2>/dev/null || true
    while IFS= read -r -d '' file; do
        all_files=$((all_files+1))
    done < "$FIND_ERR.all"
    rm -f "$FIND_ERR.all"
fi

# Run the walk to a file first so that its exit status survives. Inside a
# process substitution the status is lost, so a traversal that failed outright
# was indistinguishable from a directory that legitimately held no files.
( cd "$TARGET_DIR" && find . "${find_expr[@]}" ) > "$FILE_LIST" 2> "$FIND_ERR"
local find_status=$?
if [ $find_status -ne 0 ]; then
    error "directory walk failed (find exited $find_status); results below are incomplete"
    sed 's/^/  /' < "$FIND_ERR" >&2
fi

# Order the walk. find returns directory order, which differs between two
# runs over the same tree and makes output impossible to diff. Sorting is a
# separate step rather than a pipe on purpose: a pipeline would discard the
# find status checked just above, which is what tells a failed traversal
# apart from an empty directory.
#
# LC_ALL=C so the order is the same everywhere rather than depending on the
# caller's collation. Both engines read this file, so they stay in step.
if [ "$SORT_NUL" -eq 1 ]; then
    if LC_ALL=C sort -z "$FILE_LIST" > "$FILE_LIST.sorted" 2>/dev/null &&
       mv "$FILE_LIST.sorted" "$FILE_LIST"; then
        :
    else
        rm -f "$FILE_LIST.sorted"
        error "could not sort the walk; continuing in filesystem order"
    fi
fi

# Process files: parallel engine when more than one worker was asked for,
# otherwise the original sequential loop, byte for byte.
if [ "$JOBS" -gt 1 ]; then
    parallel_process_files "$mode"
else
while IFS= read -r -d '' file; do
    CNT_SCANNED=$((CNT_SCANNED+1))
    file="$TARGET_DIR/${file#./}"

    # Skip directories (extra safety)
    if [ -d "$file" ]; then
      [ $VERBOSE -eq 1 ] && echo "Skipping directory: $file"
      continue
  fi

  echo -n "Verifying $file ... "

  if [ "$mode" = "create" ]; then
    create_file_hash "$file"
  else
    verify_file_hash "$file"
  fi

  # 0 verified, 1 mismatch, 2 no usable sidecar, 3 I/O error,
  # 4 recorded but not read back
  case $? in
    0) CNT_OK=$((CNT_OK+1)) ;;
    1) CNT_MISMATCH=$((CNT_MISMATCH+1)); record_mismatch "$file" ;;
    2) CNT_MISSING=$((CNT_MISSING+1)) ;;
    3) CNT_IOERR=$((CNT_IOERR+1)); record_ioerr "$file" ;;
    4) CNT_UNVERIFIED=$((CNT_UNVERIFIED+1)) ;;
    5) CNT_IOERR=$((CNT_IOERR+1)); record_ioerr "$file" ;;
  esac
done < "$FILE_LIST"
fi

# Calculate skipped files if verbose
if [ $VERBOSE -eq 1 ]; then
    skipped=$((all_files - CNT_SCANNED))
    [ $skipped -gt 0 ] && echo "Skipped: $skipped files (sidecars and --exclude paths)"
fi

# Each outcome gets its own line. Collapsing them into one "failed" count
# made a corrupt file indistinguishable from a file that simply never had a
# sidecar, which are opposite situations demanding opposite responses.
echo
if [ "$CNT_SCANNED" -eq 1 ]; then
    echo "Scanned:         1 file"
else
    echo "Scanned:         $CNT_SCANNED files"
fi
echo "Verified:        $CNT_OK"
if [ "$mode" = "create" ]; then echo "Created:         $CNT_CREATED"; fi
if [ $CNT_UNVERIFIED -gt 0 ]; then echo "Not verified:    $CNT_UNVERIFIED"; fi
# Each nonzero failure counter is followed by the files behind it. A count
# on its own sends the reader back through the whole log to find out which
# file rotted, which is the one question this tool exists to answer.
echo -e "Mismatched:      ${CNT_MISMATCH}$([ $CNT_MISMATCH -gt 0 ] && echo "   ${RED}<- corrupt${NC}")"
print_failure_paths "$CNT_MISMATCH" ${MISMATCH_PATHS[@]+"${MISMATCH_PATHS[@]}"}
echo "Missing/empty:   $CNT_MISSING"
echo "I/O errors:      $CNT_IOERR"
print_failure_paths "$CNT_IOERR" ${IOERR_PATHS[@]+"${IOERR_PATHS[@]}"}
echo "Elapsed:         $(fmt_dur $((SECONDS-RUN_START)))"

# A normal create run promises to read back what it wrote. Status 6 means a
# sidecar was written but its read-back never happened because bookkeeping
# failed first, so that run has not kept the promise and must not exit 0.
# Under -c -n nothing was promised, so the warning alone stands.
if [ "$NO_VERIFY" -eq 0 ] && [ "$CNT_UNVERIFIED_AFTER_EVENT_FAIL" -gt 0 ]; then
    return 1
fi
if [ $find_status -ne 0 ]; then
    return 1
elif [ $CNT_MISMATCH -gt 0 ] || [ $CNT_IOERR -gt 0 ]; then
    return 1
elif [ $CNT_MISSING -gt 0 ] && [ "$mode" != "create" ]; then
    if [ $STRICT -eq 1 ]; then return 1; else return 2; fi
fi
return 0
}

# Parse arguments
MODE="" MAXDEPTH="" TARGET_DIR=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --version) echo "treecheck $VERSION"; exit 0 ;;
        --create) MODE="create"; shift ;;
        --force) FORCE=1; shift ;;
        --strict) STRICT=1; shift ;;
        --no-recurse) MAXDEPTH=1; shift ;;
        --max-depth)
            case "${2:-}" in
                ''|*[!0-9]*) error "--max-depth needs a non-negative integer, got: ${2:-<missing>}"; exit 1 ;;
            esac
            MAXDEPTH="$2"; shift 2 ;;
        --no-verify) NO_VERIFY=1; shift ;;
        --exclude|-e) IFS=',' read -ra EXCLUDE_DIRS <<< "$2"; shift 2 ;;
        --jobs|-j) validate_jobs "$1" "${2:-}" || exit 1; JOBS="$2"; shift 2 ;;
        --verbose) VERBOSE=1; shift ;;
        -h|--help) usage 0 ;;
        --*) error "Unknown option: $1"; usage ;;
    -*)
        for (( i=1; i<${#1}; i++ )); do
            case ${1:$i:1} in
                c) MODE="create" ;;
                f) FORCE=1 ;;
                n) NO_VERIFY=1 ;;
                V) echo "treecheck $VERSION"; exit 0 ;;
                v) VERBOSE=1 ;;
                # -j takes a value, so it must end the bundle; the number is
                # consumed from the next argument below.
                j)
                    if [ $((i+1)) -lt ${#1} ]; then
                        error "-j takes the worker count as a separate argument"
                        usage
                    fi
                    JOBS_PENDING=1 ;;
                *) error "Unknown: -${1:$i:1}"; usage ;;
            esac
        done
        shift
        if [ -n "${JOBS_PENDING:-}" ]; then
            validate_jobs "-j" "${1:-}" || exit 1
            JOBS="$1"; shift
            JOBS_PENDING=""
        fi ;;
        *) TARGET_DIR="$1"; shift ;;
    esac
done

# Validate and run
[ -z "$TARGET_DIR" ] && { error "No directory specified"; usage; }
[ ! -d "$TARGET_DIR" ] && { error "Directory not found: $TARGET_DIR"; exit 1; }

# Every reported path is built as "$TARGET_DIR/${relative#./}", so a trailing
# slash on the argument put a doubled separator in every line of every run
# started as "treecheck ./". Stripping stops at one character so that a scan
# of "/" does not normalize the target away to the empty string.
while [ ${#TARGET_DIR} -gt 1 ] && [ "${TARGET_DIR%/}" != "$TARGET_DIR" ]; do
    TARGET_DIR="${TARGET_DIR%/}"
done

# Ordering the walk needs a sort that reads NUL-separated records. That is
# not POSIX, so it is probed once here rather than assumed, in the same
# spirit as the xargs -P probe: a missing feature costs the ordering, never
# the run.
if printf 'b\0a\0' | LC_ALL=C sort -z >/dev/null 2>&1; then
    SORT_NUL=1
fi

# Resolve automatic worker count: one per CPU, on either platform.
if [ "$JOBS" -eq 0 ]; then
    JOBS=$( { sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 1; } )
    JOBS=${JOBS%%$'\n'*}
    case "$JOBS" in
        ''|*[!0-9]*|0) JOBS=1 ;;
    esac
fi

# Set default mode
[ -z "$MODE" ] && MODE="verify"

# If in verify mode with skip-verify flag, there's nothing to do
if [ "$MODE" = "verify" ] && [ $NO_VERIFY -eq 1 ]; then
    echo "Nothing to do: verify mode with skip-verify flag"
    exit 0
fi

if [ -z "$MAXDEPTH" ]; then SCOPE_DESC="Depth: unlimited"; else SCOPE_DESC="Depth: $MAXDEPTH"; fi

if [ "$MODE" = "create" ]; then
    if [ $NO_VERIFY -eq 1 ]; then
        echo "Mode: Create only | Dir: $TARGET_DIR | $SCOPE_DESC"
    else
        echo "Mode: Create + Verify | Dir: $TARGET_DIR | $SCOPE_DESC"
    fi
else
    echo "Mode: Verify only | Dir: $TARGET_DIR | $SCOPE_DESC"
fi
[ ${#EXCLUDE_DIRS[@]:-} -gt 0 ] && echo "Excluding: ${EXCLUDE_DIRS[*]}"
[ "$JOBS" -gt 1 ] && echo "Workers: $JOBS (parallel hashing)"
    echo

    run_status=0
    RUN_START=$SECONDS
    FILE_LIST=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
    FIND_ERR=$(mktemp "${TMPDIR:-/tmp}/treecheck.XXXXXX") || { error "cannot create temporary file"; exit 1; }
    process_files "$MODE" || run_status=$?
    case $run_status in
        0) success "Completed successfully" ;;
        2) echo -e "${YELLOW}Completed: nothing corrupt, but some files have no sidecar${NC}"
           exit 2 ;;
        *) error "Completed with errors"
           exit 1 ;;
    esac
